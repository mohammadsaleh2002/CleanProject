@model MyStore.Domain.Entities.Product

@{
    ViewData["Title"] = "ایجاد محصول جدید";
}

<h1>ایجاد محصول جدید</h1>
<hr />
<div class="row">
    <div class="col-md-4">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label">نام</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label">توضیحات</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="control-label">قیمت</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId" class="control-label">ID دسته‌بندی</label>
                <input asp-for="CategoryId" class="form-control" type="number" />
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <br />
            <div class="form-group">
                <input type="submit" value="ایجاد" class="btn btn-success" />
            </div>
        </form>

    </div>
</div>

<br />
<div>
    <a asp-action="Index">بازگشت به لیست</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}